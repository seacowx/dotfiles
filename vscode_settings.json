      },
      ".part.sidebar .monaco-list-row.focused.selected": {
         "background": "linear-gradient(135deg, rgba(49,50,56,0.7), rgba(37,38,44,0.5)) !important",
         "box-shadow": "inset 0 0 0 1px rgba(255,255,255,0.07) !important",
