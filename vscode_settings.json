{
   "workbench.colorTheme": "Islands Dark",
   "editor.cursorBlinking": "phase",
   "vim.argumentObjectClosingDelimiters": [
      ")",
      "]",
      "}"
   ],
   "vim.argumentObjectOpeningDelimiters": [
      "(",
      "[",
      "{"
   ],
   "vim.leader": "space",
   "vim.insertModeKeyBindings": [
      {
         "before": [
            "k",
            "j"
         ],
         "after": [
            "<Esc>"
         ]
      },
      {
         "before": [
            ";"
         ],
         "after": [
            ":"
         ],
      },
   ],
   "vim.visualModeKeyBindings": [
      {
         "before": [
            "<leader>",
            "/"
         ],
         "commands": [
            "editor.action.commentLine"
         ],
         "when": "editorTextFocus && !editorReadonly"
      },
      {
         "before": [
            ";"
         ],
         "after": [
            ":"
         ],
      },
   ],
   "vim.normalModeKeyBindings": [
      {
         "before": [
            ";"
         ],
         "after": [
            ":"
         ],
      },
      {
         "before": [
            "<leader>",
            "/"
         ],
         "commands": [
            "editor.action.commentLine"
         ],
         "when": "editorTextFocus && !editorReadonly"
      },
      {
         "before": [
            "<leader>",
            "t"
         ],
         "commands": [
            "workbench.action.terminal.toggleTerminal"
         ],
         "when": "editorTextFocus && !editorReadonly"
      },
      {
         "before": [
            "<leader>",
            "x"
         ],
         "commands": [
            "workbench.action.closeActiveEditor"
         ],
         "when": "editorTextFocus && !editorReadonly"
      },
      {
         "before": [
            "<C-n>"
         ],
         "commands": [
            "workbench.action.closeActiveEditor"
         ],
         "when": "workbench.action.toggleSidebarVisibility"
      },
      {
         "before": [
            "tab"
         ],
         "commands": [
            "workbench.action.nextEditor"
         ],
         "when": "editorTextFocus && !editorReadonly"
      },
      {
         "before": [
            "<S-tab>"
         ],
         "commands": [
            "workbench.action.previousEditor"
         ],
         "when": "editorTextFocus && !editorReadonly"
      }
   ],
   "vim.handleKeys": {
      "<C-n>": false,
   },
   "todohighlight.isEnable": true,
   "todohighlight.isCaseSensitive": false,
   "todohighlight.keywords": [
      {
         "text": "REVIEW:",
         "color": "white",
         "isWholeLine": false,
         "border": "1px solid #26a0b8",
         "borderRadius": "2px", //NOTE: using borderRadius along with `border` or you will see nothing change
         "backgroundColor": "#26a0b8",
         //other styling properties goes here ... 
      },
      {
         "text": "DEBUG:",
         "color": "white",
         // "border": "1px solid red",
         "isWholeLine": false,
         "border": "1px solid #9A348E",
         "borderRadius": "2px", //NOTE: using borderRadius along with `border` or you will see nothing change
         "backgroundColor": "#9A348E",
         //other styling properties goes here ... 
      },
      {
         "text": "WARNING:",
         "color": "white",
         "isWholeLine": false,
         "border": "1px solid #FC4100",
         "borderRadius": "2px", //NOTE: using borderRadius along with `border` or you will see nothing change
         "backgroundColor": "#FC4100",
         //other styling properties goes here ... 
      },
      {
         "text": "NOTE:",
         "color": "white",
         "isWholeLine": false,
         "border": "1px solid #86BBD8",
         "borderRadius": "2px", //NOTE: using borderRadius along with `border` or you will see nothing change
         "backgroundColor": "#86BBD8",
         // "overviewRulerColor": "grey"
      },
      // {
      //     "text": "HACK:",
      //     "color": "#000",
      //     "isWholeLine": false,
      // },
      {
         "text": "TODO:",
         "color": "white",
         "isWholeLine": false,
         "border": "1px solid #FCA17D",
         "borderRadius": "2px", //NOTE: using borderRadius along with `border` or you will see nothing change
         "backgroundColor": "#FCA17D",
         //other styling properties goes here ... 
      }
   ],
   "todohighlight.include": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "**/*.html",
      "**/*.php",
      "**/*.css",
      "**/*.scss",
      "**/*.py",
   ],
   "todohighlight.exclude": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/dist/**",
      "**/build/**",
      "**/.vscode/**",
      "**/.github/**",
      "**/_output/**",
      "**/*.min.*",
      "**/*.map",
      "**/.next/**"
   ],
   "todohighlight.maxFilesForSearch": 5120,
   "todohighlight.toggleURI": false,
   "editor.cursorSmoothCaretAnimation": "on",
   "editor.cursorWidth": 2,
   "editor.cursorSurroundingLines": 1,
   "window.titleBarStyle": "custom",
   "git.enableSmartCommit": true,
   "typescript.suggest.paths": false,
   "javascript.suggest.paths": false,
   "vim.enableNeovim": true,
   "update.showReleaseNotes": false,
   "window.title": "${activeEditorMedium}${separator}${rootName}${separator}${profileName}",
   "workbench.panel.defaultLocation": "right",
   "editor.largeFileOptimizations": false,
   "editor.suggest.showStatusBar": true,
   "workbench.editor.empty.hint": "hidden",
   "editor.wordWrap": "on",
   "remote.SSH.showLoginTerminal": false,
   "remote.SSH.externalSSH_ASKPASS": true,
   "git.openRepositoryInParentFolders": "always",
   "python.analysis.logLevel": "Warning",
   "path-intellisense.autoSlashAfterDirectory": true,
   "path-intellisense.autoTriggerNextSuggestion": true,
   "files.autoSave": "onFocusChange",
   "editor.fontVariations": false,
   "errorLens.fontStyleItalic": true,
   "errorLens.fontWeight": "500",
   "errorLens.gutterIconsEnabled": true,
   "errorLens.removeLinebreaks": false,
   "errorLens.scrollbarHackEnabled": true,
   "errorLens.followCursor": "activeLine",
   "cSpell.enabledFileTypes": {
      "javascript": true,
      "javascriptreact": true,
      "typescript": true,
      "typescriptreact": true,
      "html": true,
      "css": true,
      "json": true,
      "python": false,
   },
   "editor.semanticHighlighting.enabled": false,
   "editor.tokenColorCustomizations": {
      "[Islands Dark]": {
         "textMateRules": [
            {
               "name": "Python 'self' variable",
               "scope": [
                  "variable.language.special.self.python"
               ],
               "settings": {
                  "foreground": "#f15151",
                  "fontStyle": "italic"
               }
            },
            {
               "name": "Python function call arguments",
               "scope": [
                  "meta.function-call.arguments.python",
                  "meta.function-call.arguments.python variable",
                  "meta.function-call.arguments.python string",
                  "meta.function-call.arguments.python constant.numeric",
                  "meta.function-call.arguments.python keyword"
               ],
               "settings": {
                  "foreground": "#f29e37"
               }
            },
            {
               "name": "Python call argument punctuation",
               "scope": [
                  "meta.function-call.arguments.python punctuation",
                  "meta.function-call.arguments.python punctuation.separator",
                  "meta.function-call.arguments.python punctuation.definition.arguments"
               ],
               "settings": {
                  "foreground": "#ca941f"
               }
            },
            {
               "name": "Python function call name/expression",
               "scope": [
                  "meta.function-call.python entity.name.function",
                  "meta.function-call.python support.function",
                  "meta.function-call.python variable.function"
               ],
               "settings": {
                  "foreground": "#e78482",
                  "fontStyle": ""
               }
            },
            {
               "name": "Python function declarations",
               "scope": [
                  "entity.name.function.python",
                  "support.function.magic.python"
               ],
               "settings": {
                  "foreground": "#c77dbb",
                  "fontStyle": ""
               }
            },
            {
               "name": "Python keywords",
               "scope": [
                  "keyword.control.flow.python",
                  "storage.type.function.python",
                  "storage.type.class.python",
                  "storage.modifier.declaration.python"
               ],
               "settings": {
                  "foreground": "#ff7c17"
               }
            },
            {
               "name": "Python strings",
               "scope": [
                  "string.quoted.python",
                  "string.template.python"
               ],
               "settings": {
                  "foreground": "#9ad49e"
               }
            },
            {
               "name": "Python numbers/constants",
               "scope": [
                  "constant.numeric.python",
                  "constant.language.python"
               ],
               "settings": {
                  "foreground": "#ff9e17"
               }
            }
         ]
      }
   },

   "editor.semanticTokenColorCustomizations": {
      "[Islands Dark]": {
         "enabled": true,
         "rules": {
            "function": "#56a8f5",
            "method": "#56a8f5",
            "parameter": "#bcbec4",
            "variable": "#bcbec4",
            "property": "#c77dbb",
            "type": "#c77dbb",
            "class": "#c77dbb",
            "decorator": "#bbb529",
            "string": "#6aab73",
            "number": "#2aacb8",
            "keyword": "#cf8e6d",
            "comment": {
               "foreground": "#7a7e85",
               "fontStyle": "italic"
            }
         }
      }
   },
   "editor.fontFamily": "Maple Mono NF",
   "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono",
   "editor.lineHeight": 1.8,
   "workbench.tree.indent": 16,
   "workbench.tree.renderIndentGuides": "always",
   "editor.minimap.showSlider": "always",

   "custom-ui-style.stylesheet": {
      ".monaco-workbench": {
         "--islands-panel-radius": "24px",
         "--islands-widget-radius": "14px",
         "--islands-input-radius": "12px",
         "--islands-item-radius": "6px",
         "--islands-panel-gap": "6px",
         "--islands-panel-top": "6px",
         // "--islands-bg-canvas": "#28282e",
         "--islands-bg-canvas": "#000000",
         "--islands-bg-surface": "#181a1d",
         "background-color": "var(--islands-bg-canvas) !important"
      },
      ".part.sidebar": {
         "font-family": "'Bear Sans UI', sans-serif !important",
         "margin": "var(--islands-panel-top) var(--islands-panel-gap) 0 var(--islands-panel-gap)",
         "border-radius": "var(--islands-panel-radius) !important",
         "overflow": "hidden !important",
         "max-height": "calc(100% - 8px) !important",
         "border-top": "1px solid rgba(255,255,255,0.1) !important",
         "border-left": "1px solid rgba(255,255,255,0.06) !important",
         "border-bottom": "1px solid rgba(255,255,255,0.02) !important",
         "border-right": "1px solid rgba(255,255,255,0.02) !important",
         "box-shadow": "0 2px 8px 0 rgba(0,0,0,0.3) !important"
      },
      ".part.sidebar .composite.title": {
         "padding": "8px 20px 0 0 !important"
      },
      ".part.sidebar .title-label h2": {
         "font-family": "'Bear Sans UI Heading', sans-serif !important",
         "font-size": "12px !important",
         "font-weight": "700 !important",
         "text-transform": "uppercase !important",
         "letter-spacing": "1px !important"
      },
      ".part.sidebar .content": {
         "width": "calc(100% - 20px) !important",
         "padding-left": "10px !important",
         "margin-left": "6px !important"
      },
      ".part.sidebar .welcome-view-content": {
         "max-width": "100% !important",
         "box-sizing": "border-box !important"
      },
      ".part.sidebar .pane-header": {
