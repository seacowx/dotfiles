      },
      ".part.sidebar .pane-header .title": {
         "font-size": "10px !important"
      },
      ".explorer-folders-view .monaco-tl-row": {
         "padding-top": "1px !important",
         "padding-bottom": "1px !important"
      },
      ".part.sidebar .monaco-list-row": {
